#include <windows.h>
#include "resource.h"

IDR_LAYOUT_65_PERCENT_ANSI RCDATA "..\\data\\layouts\\65_percent_ansi.json"
IDR_LAYOUT_60_PERCENT      RCDATA "..\\data\\layouts\\sixty_percent.json"
IDR_LAYOUT_40_PERCENT      RCDATA "..\\data\\layouts\\forty_percent.json"
IDR_LAYOUT_75_PERCENT      RCDATA "..\\data\\layouts\\seventy_five_percent.json"
IDR_LAYOUT_TKL             RCDATA "..\\data\\layouts\\tkl.json"
IDR_LAYOUT_1800_COMPACT    RCDATA "..\\data\\layouts\\layout_1800_compact.json"
IDR_LAYOUT_FULL_SIZE_ANSI  RCDATA "..\\data\\layouts\\full_size_ansi.json"

IDD_KEY_PICKER DIALOGEX 0, 0, 320, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pick a Key"
FONT 8, "Segoe UI"
BEGIN
    LTEXT           "Select the key to remap to:", -1, 10, 10, 300, 12
    LISTBOX         IDC_KEY_LIST, 10, 28, 300, 180, LBS_NOTIFY | WS_VSCROLL | WS_BORDER
    AUTOCHECKBOX    "Disable this key", IDC_DISABLED_CHK, 10, 215, 200, 12
    DEFPUSHBUTTON   "OK", IDOK, 200, 240, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 260, 240, 50, 14
END
